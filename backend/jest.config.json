{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests", "<rootDir>/src"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "paths": {
          "@agcs/shared": ["../shared/src"]
        }
      }
    }]
  },
  "moduleNameMapper": {
    "^@agcs/shared$": "<rootDir>/../shared/src/index.ts"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/index.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 60,
      "functions": 60,
      "lines": 60,
      "statements": 60
    }
  }
}
