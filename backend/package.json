{
  "name": "@agcs/backend",
  "version": "1.0.0",
  "description": "Backend service for the Agentic Generative Creative Studio",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
