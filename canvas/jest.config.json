{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests", "<rootDir>/src"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
      }
    }]
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/index.ts"
  ]
}
